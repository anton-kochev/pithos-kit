{
  "name": "@pithos-kit/clio",
  "version": "0.9.1",
  "description": "Clio: documents committed work in the background and commits the good doc changes as their own docs(clio) commits.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pithos",
    "documentation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anton-kochev/pithos-kit.git",
    "directory": "pithos.clio"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=1.0.3",
    "@earendil-works/pi-ai": ">=1.0.3",
    "@earendil-works/pi-coding-agent": ">=1.0.3",
    "@earendil-works/pi-tui": ">=1.0.3",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.0.3",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@earendil-works/pi-tui": "1.0.3",
    "typebox": "1.3.27",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.0"
  },
  "pithosKit": {
    "displayName": "Clio",
    "summary": "After new commits, drafts doc updates from the diff and the session, grades them with a classifier, and commits the good ones separately.",
    "minimumPi": ">=1.0.3",
    "commands": [
      {
        "name": "clio",
        "usage": "/clio [--since <rev>] | review | undo [--yes] | status [--probe] | --help",
        "summary": "Capture new commits now, review the inbox, undo the last Clio commit, or show status."
      }
    ],
    "tools": [],
    "prompts": [],
    "skills": [],
    "themes": [],
    "agents": [],
    "configuration": [
      {
        "kind": "file",
        "key": ".pi/clio.json",
        "summary": "Project-local worker model, classifier, docs directories, autoCommit and limits."
      }
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [],
    "prompts": [],
    "themes": []
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  }
}
