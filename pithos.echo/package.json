{
  "name": "@pithos-kit/echo",
  "version": "0.5.0",
  "description": "Echo: a read-only side-channel question asker for Pi sessions and project code.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pithos",
    "echo",
    "ask",
    "read-only"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anton-kochev/pithos-kit.git",
    "directory": "pithos.echo"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "jiti": "^2.4.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "pithosKit": {
    "displayName": "Echo",
    "summary": "Ask an isolated read-only side agent about the session and project.",
    "minimumPi": ">=0.83.0",
    "commands": [
      { "name": "ask", "usage": "/ask [--model <provider/model>] [--] <question>", "summary": "Ask Echo a read-only side-channel question." },
      { "name": "asked", "usage": "/asked [--help]", "summary": "Browse saved Echo answers." },
      { "name": "ask-clear", "usage": "/ask-clear [--help]", "summary": "Hide a stale Echo answer widget." }
    ],
    "tools": [],
    "prompts": [],
    "skills": [],
    "themes": [],
    "agents": [],
    "configuration": []
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions",
    "src",
    "README.md"
  ]
}
