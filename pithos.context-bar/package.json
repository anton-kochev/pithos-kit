{
  "name": "@pithos-kit/context-bar",
  "version": "0.2.0",
  "description": "A context-window composition bar with ChatGPT Codex subscription usage for Pi.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pithos",
    "context-window",
    "tokens",
    "codex",
    "subscription-usage",
    "tui"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anton-kochev/pithos-kit.git",
    "directory": "pithos.context-bar"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "^0.84.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0"
  },
  "pithosKit": {
    "displayName": "Context Bar",
    "summary": "Show context-window composition above the editor and ChatGPT Codex usage in the footer.",
    "minimumPi": ">=1.0.0",
    "commands": [
      { "name": "context-bar", "usage": "/context-bar [on|off|status|refresh|--help]", "summary": "Toggle or inspect context composition and Codex subscription usage." }
    ],
    "tools": [],
    "prompts": [],
    "skills": [],
    "themes": [],
    "agents": [],
    "configuration": [
      { "kind": "environment", "key": "PI_OFFLINE", "summary": "Disable ChatGPT Codex usage requests when true, yes, or 1." }
    ]
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=moderate"
  }
}
