{
  "name": "@pithos-kit/translate",
  "version": "2.0.0",
  "description": "Translate interactive input into English and assistant output into a chosen language for Pi.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pithos",
    "translation",
    "i18n"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anton-kochev/pithos-kit.git",
    "directory": "pithos.translate"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=1.0.0",
    "@earendil-works/pi-coding-agent": ">=1.0.0",
    "@earendil-works/pi-tui": ">=1.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "pithosKit": {
    "displayName": "Translate",
    "summary": "Translate interactive input into English and assistant output manually or display-only.",
    "minimumPi": ">=1.0.0",
    "commands": [
      {
        "name": "translate",
        "usage": "/translate [input-on|input-off|input-status|input-config|output-on|output-off|output-status|output-config|--help]",
        "summary": "Translate interactive input into English or manage assistant-output translation."
      }
    ],
    "tools": [],
    "prompts": [],
    "skills": [],
    "themes": [],
    "agents": [],
    "configuration": [
      {
        "kind": "file",
        "key": ".pi/translate.json",
        "summary": "Project-scoped input/output translation models, modes, target language, and optional request timeouts."
      }
    ]
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions",
    "src",
    "README.md"
  ]
}
